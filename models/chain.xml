<!--
  阶段 10 的链条：12 节 0.15 m 的胶囊，用球关节串起来挂在世界上（链深 12，一棵树，36 个自由度）。
  起始姿态水平伸出（q = 0 时每节都沿 +x），静止释放：整条链甩下来，下面的几节扫过地面，链节之间也会互相碰到
  （相邻的链节是父子，不检测；隔一节以上的都检测）。
  这是阶段 5 的加速度界和阶段 6 的曲率上界最吃力的场景：深链上的静态力臂很松。
-->
<mujoco model="chain">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <default class="link">
      <geom type="capsule" fromto="0.02 0 0 0.13 0 0" size="0.02" mass="0.2"/>
      <joint type="ball" pos="0 0 0"/>
    </default>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="3 3 0.1"/>
    <body name="link1" pos="0 0 1.0">
      <joint class="link" name="j1"/>
      <geom class="link"/>
      <body name="link2" pos="0.15 0 0">
        <joint class="link" name="j2"/>
        <geom class="link"/>
        <body name="link3" pos="0.15 0 0">
          <joint class="link" name="j3"/>
          <geom class="link"/>
          <body name="link4" pos="0.15 0 0">
            <joint class="link" name="j4"/>
            <geom class="link"/>
            <body name="link5" pos="0.15 0 0">
              <joint class="link" name="j5"/>
              <geom class="link"/>
              <body name="link6" pos="0.15 0 0">
                <joint class="link" name="j6"/>
                <geom class="link"/>
                <body name="link7" pos="0.15 0 0">
                  <joint class="link" name="j7"/>
                  <geom class="link"/>
                  <body name="link8" pos="0.15 0 0">
                    <joint class="link" name="j8"/>
                    <geom class="link"/>
                    <body name="link9" pos="0.15 0 0">
                      <joint class="link" name="j9"/>
                      <geom class="link"/>
                      <body name="link10" pos="0.15 0 0">
                        <joint class="link" name="j10"/>
                        <geom class="link"/>
                        <body name="link11" pos="0.15 0 0">
                          <joint class="link" name="j11"/>
                          <geom class="link"/>
                          <body name="link12" pos="0.15 0 0">
                            <joint class="link" name="j12"/>
                            <geom class="link"/>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
