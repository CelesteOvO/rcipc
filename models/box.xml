<!--
  阶段 3 的自由刚体：一个三边长度都不同的盒子（0.1 x 0.2 x 0.4 m，1 kg），带自由关节。
  三个主惯量各不相同，绕中间那根轴旋转是不稳定的（“网球拍定理”，会周期性地翻转），
  适合检查转动部分的惯性项：没有外力时动能应当守恒，数值上只允许减少，不允许增加。
  测试里会把重力关掉（Model::gravity 设为 0）。
-->
<mujoco model="box">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <worldbody>
    <body name="box" pos="0 0 1">
      <freejoint name="root"/>
      <geom type="box" size="0.05 0.1 0.2" mass="1"/>
    </body>
  </worldbody>
</mujoco>
