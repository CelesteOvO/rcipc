<!--
  由 compare/rigid_ipc/import_rigid_ipc.py 从 Rigid-IPC 的 ../../../rigid-ipc/fixtures/3D/chain/10-links.json 生成，
  scene_demo 参数：T=10 h=0.01 dhat=0.001 mu=0（笔记 notes/compare_rigid_ipc.md）。
  这个文件是 chain_10.xml 只留前两个环（固定的 torus0 和挂着的 torus1）截出来的：CPU 上几秒就能看静止时每次 Newton 迭代
  （notes/17_contact_hessian.md 第 3.2 节，scene_demo debug=3）。
-->
<mujoco model="2-links">
  <compiler angle="radian" meshdir="D:/Project/rigid-ipc/meshes"/>
  <option gravity="0 -9.81 0" timestep="0.01"/>
  <default>
    <geom friction="0 0 0"/>
  </default>
  <asset>
    <mesh name="torus" file="torus.obj" scale="1 1 1" inertia="shell"/>
    <mesh name="torus_1" file="torus.obj" scale="1 1 1" inertia="exact"/>
  </asset>
  <worldbody>
    <geom name="torus0" type="mesh" mesh="torus" pos="0 1.5 0" quat="1 0 0 0"/>
    <body name="torus1" pos="0 0.95 0" quat="0.707106781 0 0.707106781 0">
      <freejoint/>
      <geom name="torus1" type="mesh" mesh="torus_1" density="1000"/>
    </body>
  </worldbody>
</mujoco>
